<main class="auth-shell auth-shell-wide">
  <section class="auth-panel">
    <p class="eyebrow">A NEW WORKSPACE</p>
    <h1>Make room for good work.</h1>
    <p class="muted">Start an organization and become its administrator.</p>
    <% errors = @organization.errors.full_messages + @user.errors.full_messages %>
    <% if errors.any? %>
      <ul class="error-list"><% errors.uniq.each do |error| %><li><%= error %></li><% end %></ul>
    <% end %>
    <%= form_with url: sign_up_path, class: "form-stack" do |form| %>
      <div class="form-grid">
        <div class="field"><%= form.label "organization[name]", "Organization name" %><%= form.text_field "organization[name]", required: true, value: @organization.name %></div>
        <div class="field"><%= form.label "organization[segment]", "Industry" %><%= form.text_field "organization[segment]", value: @organization.segment %></div>
      </div>
      <div class="field"><%= form.label "organization[description]", "Organization description" %><%= form.text_area "organization[description]", rows: 2, value: @organization.description %></div>
      <div class="form-grid">
        <div class="field"><%= form.label "user[first_name]", "First name" %><%= form.text_field "user[first_name]", required: true, autocomplete: "given-name", value: @user.first_name %></div>
        <div class="field"><%= form.label "user[last_name]", "Last name" %><%= form.text_field "user[last_name]", required: true, autocomplete: "family-name", value: @user.last_name %></div>
      </div>
      <div class="field"><%= form.label "user[email]", "Email" %><%= form.email_field "user[email]", required: true, autocomplete: "email", value: @user.email %></div>
      <div class="field"><%= form.label "user[username]", "Username (optional)" %><%= form.text_field "user[username]", autocomplete: "username", value: @user.username %></div>
      <div class="form-grid">
        <div class="field"><%= form.label "user[password]", "Password" %><%= form.password_field "user[password]", required: true, minlength: 8, autocomplete: "new-password" %></div>
        <div class="field"><%= form.label "user[password_confirmation]", "Confirm password" %><%= form.password_field "user[password_confirmation]", required: true, autocomplete: "new-password" %></div>
      </div>
      <%= form.submit "Create workspace", class: "button button-full" %>
    <% end %>
    <p class="form-footnote">Already have an account? <%= link_to "Log in", login_path %></p>
  </section>
</main>